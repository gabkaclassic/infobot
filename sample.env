# Bot
BOT_TOKEN=...
SETUP_ENABLE=True
IMAGES_PATH=./images
TREE_PATH=./trees/tree.txt
ADMINS=ID1,ID2
GREETING=Hi, have a good day!
GET_ID_INSTRUCTION=I need your clothes, your boots and your telegram ID

# App
# Слушать только localhost: наружу приложение публикует реверс-прокси.
# 0.0.0.0 нужен, только если прокси стоит на другом хосте.
HOST=127.0.0.1
PORT=8000
DEV=False
# IP реверс-прокси, которому доверяется заголовок X-Forwarded-For.
# Без этого проверка IP ЮKassa увидит адрес прокси и отклонит все вебхуки.
FORWARDED_ALLOW_IPS=127.0.0.1

# Logging
# DEBUG выводит в stdout запросы aiohttp вместе с токеном бота, на проде не использовать.
LOG_LEVEL=INFO
LOG_DIR=

# Payment
PAYMENT_COST=1.0
PAYMENT_DESCRIPTION=Оплата бота
PAYMENT_PRIVILEGED_USERS=ID1,ID2
PAYMENT_ACCOUNT_ID=
PAYMENT_SECRET_KEY=
PAYMENT_ENABLE=True
PAYMENT_PHONE=
PAYMENT_EMAIL=
PAYMENT_WEBHOOK_URL=

# DB
DB_HOST=localhost
DB_PORT=6379
DB_PASSWORD=password
# Redis настроен через requirepass, без ACL. Пользователя указывать не нужно:
# непустой DB_USER заставит клиент слать AUTH <user> <password> и получить WRONGPASS.
DB_USER=
